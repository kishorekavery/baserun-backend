# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here

# ==========================================
# PostgreSQL (Supabase, Neon, RDS, local, ...)
# ==========================================
# Either a full connection URI...
# DATABASE_URL=postgresql://user:password@host:5432/baserun_db?sslmode=require

# ...or discrete credentials (DB_* names are accepted too)
EXTERNAL_DB_HOST=localhost
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_NAME=baserun_db
EXTERNAL_DB_USER=postgres
EXTERNAL_DB_PASSWORD=your_db_password_here
EXTERNAL_DB_SSLMODE=prefer
EXTERNAL_DB_MIN_CONNECTIONS=1
EXTERNAL_DB_MAX_CONNECTIONS=10
EXTERNAL_DB_TIMEOUT=10.0

# Apply db/schema.sql automatically on startup (set to false if the DB role cannot run DDL)
DB_AUTO_MIGRATE=true

# Sessions
SESSION_TTL_SECONDS=86400
SESSION_MODE=idle
MAX_SESSIONS_PER_USER=1
SESSION_ABSOLUTE_MAX_SECONDS=2592000

# Social login, reconnecting a provider and deleting a social account: accepted OAuth client ids (audience check)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Local development only: trust the email in the request body instead of verifying the token
SOCIAL_LOGIN_ALLOW_UNVERIFIED=false

# Public origin used to build profile photo URLs, e.g. https://baserun-backend-gamma.vercel.app
# Leave empty to use the host of each upload request
PUBLIC_BASE_URL=

# Splash screen
APP_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
MAINTENANCE_MODE=false
