# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here

# Database Selection: "sqlite" (default local file) or "postgresql"
DATABASE_TYPE=sqlite
DATABASE_PATH=baserun.db

# ==========================================
# External Database Configuration & Credentials
# ==========================================
# Use for remote PostgreSQL (e.g. Supabase, Render, Neon, AWS RDS, GCP Cloud SQL)
EXTERNAL_DB_TYPE=postgresql
EXTERNAL_DB_HOST=localhost
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_NAME=baserun_db
EXTERNAL_DB_USER=postgres
EXTERNAL_DB_PASSWORD=your_external_db_password_here
EXTERNAL_DB_SSLMODE=prefer
EXTERNAL_DB_MIN_CONNECTIONS=1
EXTERNAL_DB_MAX_CONNECTIONS=10
EXTERNAL_DB_TIMEOUT=10.0

# Alternatively, provide a single full connection URI (overrides individual credentials above):
# EXTERNAL_DATABASE_URL=postgresql://user:password@host:5432/baserun_db?sslmode=prefer
